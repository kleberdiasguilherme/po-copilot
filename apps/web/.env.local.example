# Copie para .env.local. O .env.local fica fora do git.
#
# URL base da API, sem barra no fim. O prefixo NEXT_PUBLIC_ expoe a variavel
# ao browser e o Next a embute no bundle durante o build — logo, ela precisa
# existir na Vercel no momento do build, nao so em runtime.
#
# Local:     http://localhost:8000
# Producao:  a URL publica do servico na Railway
NEXT_PUBLIC_API_URL=http://localhost:8000
