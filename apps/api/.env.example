# Copie para .env. O .env fica fora do git — nunca commite valores reais.

# Vazio ate o M1, quando a integracao com a Anthropic entra.
ANTHROPIC_API_KEY=

# development em local, production na Railway.
ENVIRONMENT=development

# Origens liberadas no CORS, separadas por virgula.
# Em producao: a URL da Vercel, ex. https://po-copilot.vercel.app
CORS_ORIGINS=http://localhost:3000
